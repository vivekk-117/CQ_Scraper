# ==============================================================================
# Environment Configuration & API Keys
# Rename or copy this file to .env and fill in your credentials
# ==============================================================================

# LLM Providers (Groq is prioritized for ultra-fast, zero-cost execution)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Search Providers (LangSearch is prioritized for live web search queries)
LANGSEARCH_API_KEY=your_langsearch_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# Google Sheets Configuration
# Path to your Google Service Account JSON credentials file
GOOGLE_APPLICATION_CREDENTIALS=config/google_credentials.json
# Optional target spreadsheet ID (if left blank, agent will create a new sheet)
GOOGLE_SPREADSHEET_ID=

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CRAWL_TIMEOUT_SECONDS=12.0
MAX_SEARCH_RESULTS_PER_QUERY=5
MAX_LEAD_TARGETS=15
