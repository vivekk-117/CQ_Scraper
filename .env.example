# ==============================================================================
# Environment Configuration & API Keys
# Rename or copy this file to .env and fill in your credentials
# ==============================================================================

# ── 1. Provider Selection ─────────────────────────────────────────────────────
# Options: auto | groq | openai | anthropic
# 'auto' automatically selects whichever provider has a valid API key configured.
LLM_PROVIDER=auto

# Options: auto | langsearch | tavily | serper
# 'auto' prioritizes LangSearch -> Tavily -> Serper -> deterministic test fallback.
SEARCH_PROVIDER=auto

# Optional: Universal model override across any provider (leave blank to use defaults)
LLM_MODEL=

# ── 2. LLM Providers ──────────────────────────────────────────────────────────
# Groq (Zero-cost free tier, blazing-fast inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── 3. Web Search Providers ───────────────────────────────────────────────────
# LangSearch (Real-time live Google/web results)
LANGSEARCH_API_KEY=your_langsearch_api_key_here

# Tavily & Serper
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# ── 4. Google Sheets Integration (Optional) ───────────────────────────────────
# Path to your Google Service Account JSON credentials file
GOOGLE_APPLICATION_CREDENTIALS=config/google_credentials.json
# Optional target spreadsheet ID (if left blank, agent will create a new sheet)
GOOGLE_SPREADSHEET_ID=

# ── 5. Application & Crawling Settings ────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CRAWL_TIMEOUT_SECONDS=12.0
MAX_SEARCH_RESULTS_PER_QUERY=5
MAX_LEAD_TARGETS=15
